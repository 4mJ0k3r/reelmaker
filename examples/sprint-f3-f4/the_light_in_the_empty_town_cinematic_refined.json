      "style": "subtitle",
      "lines": [
        "They took the forest road."
      ]
    },
    {
      "start": 180,
      "end": 270,
      "style": "subtitle",
      "lines": [
        "Mira refused to turn back."
      ]
    },
    {
      "start": 270,
      "end": 360,
      "style": "subtitle",
      "lines": [
        "Bram had one parcel left."
      ]
    },
    {
      "start": 360,
      "end": 450,
      "style": "subtitle",
      "lines": [
        "The creek crossed their route."
      ]
    },
    {
      "start": 450,
      "end": 540,
      "style": "subtitle",
      "lines": [
        "Bram took it across by cart."
      ]
    },
    {
      "start": 540,
      "end": 630,
      "style": "subtitle",
      "lines": [
        "They followed the ridge down."
      ]
    },
    {
      "start": 630,
      "end": 720,
      "style": "subtitle",
      "lines": [
        "The village was just beyond it."
      ]
    },
    {
      "start": 720,
      "end": 810,
      "style": "subtitle",
      "lines": [
        "The village stood silent."
      ]
    },
    {
      "start": 810,
      "end": 900,
      "style": "subtitle",
      "lines": [
        "No doors opened."
      ]
    },
    {
      "start": 900,
      "end": 990,
      "style": "subtitle",
      "lines": [
        "Bram picked up the parcel."
      ]
    },
    {
      "start": 990,
      "end": 1080,
      "style": "subtitle",
      "lines": [
        "He set it by the lane."
      ]
    },
    {
      "start": 1080,
      "end": 1170,
      "style": "subtitle",
      "lines": [
        "He left it for whoever came."
      ]
    },
    {
      "start": 1170,
      "end": 1260,
      "style": "subtitle",
      "lines": [
        "Mira searched. No one answered."
      ]
    },
    {
      "start": 1260,
      "end": 1440,
      "style": "subtitle",
      "lines": [
        "They decided to wait."
      ]
    },
    {
      "start": 1440,
      "end": 1530,
      "style": "subtitle",
      "lines": [
        "One last moment..."
      ]
    },
    {
      "start": 1530,
      "end": 1620,
      "style": "subtitle",
      "lines": [
        "A lamp came on."
      ]
    },
    {
      "start": 1620,
      "end": 1710,
      "style": "subtitle",
      "lines": [
        "Mira saw it first."
      ]
    },
    {
      "start": 1710,
      "end": 1800,
      "style": "subtitle",
      "lines": [
        "They were not alone."
      ]
